  lcd.setCursor(0, 1);
  lcd.print("Starting...");
  delay(2000);
  lcd.clear();

  setupTinyML();

  initProperties();
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);
  setDebugMessageLevel(2);
  ArduinoCloud.printDebugInfo();
}

// =====================================================
// LOOP
// =====================================================
void loop() {
  ArduinoCloud.update();

  // Keep same NPK serial RX logic
  readNPKSerial();

  // Sensor read
  float temperature = dht.readTemperature();
  float humidityVal = dht.readHumidity();
  int soilRaw = analogRead(SOIL_SENSOR);

  if (isnan(temperature)) temperature = 0;
  if (isnan(humidityVal)) humidityVal = 0;

  int moistureVal = moisturePercent(soilRaw);

  String tempS = getTempStatus(temperature);
  String humS  = getHumStatus(humidityVal);
  String moistS = getMoistStatus(moistureVal);

  // Individual IoT vars
  tempi = temperature;
  humid = (int)humidityVal;
  moisture = moistureVal;

  // IoT app strings
  npkstatus = getCropFertilizerRecommendation(
    temperature, humidityVal, moistureVal,
    N_value, P_value, K_value
  );

  // TinyML-based AI status
  status = predictTinyMLStatus(
    temperature, humidityVal, moistureVal,
    N_value, P_value, K_value
  );

  // Serial print
  if (millis() - lastSerialPrint >= 2000) {
    lastSerialPrint = millis();

    Serial.print("Temp: "); Serial.print(temperature, 1);
    Serial.print(" | Hum: "); Serial.print(humidityVal, 1);
    Serial.print(" | Moist: "); Serial.print(moistureVal);
    Serial.print(" | N: "); Serial.print(N_value, 1);
    Serial.print(" P: "); Serial.print(P_value, 1);
    Serial.print(" K: "); Serial.print(K_value, 1);
    Serial.print(" | ");
    Serial.print(npkstatus);
    Serial.print(" | ");
    Serial.println(status);
  }

  // ================= LCD SAME STYLE =================
  if (millis() - lastLCDUpdate >= 1000) {
    lastLCDUpdate = millis();

    // First line
    lcd.setCursor(0, 0);
    lcd.print("                ");
    lcd.setCursor(0, 0);
    lcd.print("T");
    lcd.print((int)temperature);
    lcd.print(tempS);
    lcd.print(" H");
    lcd.print((int)humidityVal);
    lcd.print(humS);
    lcd.print(" M");
    lcd.print(moistureVal);
    lcd.print(moistS);

    // Second line
    lcd.setCursor(0, 1);
    lcd.print("                ");
    lcd.setCursor(0, 1);
    lcd.print("N");
    lcd.print((int)N_value);
    lcd.print(" P");
    lcd.print((int)P_value);
    lcd.print(" K");
    lcd.print((int)K_value);
  }
}

