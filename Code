// =====================================================
// NORMALIZATION FOR TINYML INPUT
// =====================================================
float normalizeInput(float x, float xmin, float xmax) {
  if ((xmax - xmin) == 0) return 0.0;
  float val = (x - xmin) / (xmax - xmin);
  if (val < 0) val = 0;
  if (val > 1) val = 1;
  return val;
}

// =====================================================
// REASON STRING
// =====================================================
String getReasonFromInputs(float t, float h, int m, float n, float p, float k) {
  String reason = "";

  if (t < 20 || t > 38) reason += "Temp out, ";
  else if ((t >= 20 && t < 25) || (t > 35 && t <= 38)) reason += "Temp moderate, ";

  if (h < 30 || h > 85) reason += "Humidity critical, ";
  else if ((h >= 30 && h < 40) || (h > 70 && h <= 85)) reason += "Humidity moderate, ";

  if (m < 20) reason += "Soil dry, ";
  else if (m < 40) reason += "Soil slight dry, ";
  else if (m > 85) reason += "Soil too wet, ";

  if (n < 35) reason += "N low, ";
  if (p < 35) reason += "P low, ";
  if (k < 35) reason += "K low, ";

  if (reason.length() == 0) {
    return "All parameters normal";
  }

  if (reason.endsWith(", ")) {
    reason.remove(reason.length() - 2);
  }
  return reason;
}

// =====================================================
// TinyML Prediction
// class 0 = Good
// class 1 = Moderate
// class 2 = Poor
// =====================================================
String predictTinyMLStatus(float t, float h, int m, float n, float p, float k) {
  input->data.f[0] = normalizeInput(t, X_MIN[0], X_MAX[0]);
  input->data.f[1] = normalizeInput(h, X_MIN[1], X_MAX[1]);
  input->data.f[2] = normalizeInput((float)m, X_MIN[2], X_MAX[2]);
  input->data.f[3] = normalizeInput(n, X_MIN[3], X_MAX[3]);
  input->data.f[4] = normalizeInput(p, X_MIN[4], X_MAX[4]);
  input->data.f[5] = normalizeInput(k, X_MIN[5], X_MAX[5]);

  TfLiteStatus invoke_status = interpreter->Invoke();
  if (invoke_status != kTfLiteOk) {
    return "AI:ModelErr | Reason:Inference failed";
  }

  float goodProb = output->data.f[0];
  float modProb  = output->data.f[1];
  float poorProb = output->data.f[2];

  int predClass = 0;
  float maxProb = goodProb;

  if (modProb > maxProb) {
    maxProb = modProb;
    predClass = 1;
  }
  if (poorProb > maxProb) {
    maxProb = poorProb;
    predClass = 2;
  }

  String aiState = "Good";
  if (predClass == 1) aiState = "Moderate";
  else if (predClass == 2) aiState = "Poor";

  String reason = getReasonFromInputs(t, h, m, n, p, k);

  return "AI:" + aiState + " | Reason:" + reason;
}

// =====================================================
// TINYML INIT
// =====================================================
void setupTinyML() {
  model = tflite::GetModel(g_model);
  if (model->version() != TFLITE_SCHEMA_VERSION) {
    Serial.println("Model schema mismatch!");
    return;
  }

  static tflite::MicroInterpreter static_interpreter(
    model, resolver, tensor_arena, tensor_arena_size, error_reporter
  );

  interpreter = &static_interpreter;

  TfLiteStatus allocate_status = interpreter->AllocateTensors();
  if (allocate_status != kTfLiteOk) {
    Serial.println("AllocateTensors failed");
    return;
  }

  input = interpreter->input(0);
  output = interpreter->output(0);

  Serial.println("TinyML model loaded successfully");
}

