// =====================================================
// NPK SERIAL RX
// Expected format example: N45.0P38.0K60.0
// =====================================================
void readNPKSerial() {
  while (Serial2.available()) {
    String line = Serial2.readStringUntil('\n');
    line.trim();

    if (line.length() > 0) {
      int nIndex = line.indexOf('N');
      int pIndex = line.indexOf('P');
      int kIndex = line.indexOf('K');

      if (nIndex >= 0 && pIndex > nIndex && kIndex > pIndex) {
        String nStr = line.substring(nIndex + 1, pIndex);
        String pStr = line.substring(pIndex + 1, kIndex);
        String kStr = line.substring(kIndex + 1);

        N_value = nStr.toFloat();
        P_value = pStr.toFloat();
        K_value = kStr.toFloat();

        Serial.print("Received NPK -> ");
        Serial.print("N: "); Serial.print(N_value, 1);
        Serial.print(" P: "); Serial.print(P_value, 1);
        Serial.print(" K: "); Serial.println(K_value, 1);
      }
    }
  }
}

// =====================================================
// MOISTURE PERCENT
// =====================================================
int moisturePercent(int raw) {
  if (raw <= SOIL_MIN) return 100;
  if (raw >= SOIL_MAX) return 0;
  return map(raw, SOIL_MIN, SOIL_MAX, 100, 0);
}

