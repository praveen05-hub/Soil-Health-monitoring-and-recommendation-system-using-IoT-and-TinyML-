String getTempStatus(float t) {
  if (t < 25) return "L";
  else if (t <= 35) return "N";
  else return "H";
}

String getHumStatus(float h) {
  if (h < 40) return "L";
  else if (h <= 70) return "N";
  else return "H";
}

String getMoistStatus(int m) {
  if (m >= 50) return "W";
  else return "D";
}

